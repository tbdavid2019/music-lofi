{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/bing-official",
      "destination": "https://www.bing.com/HPImageArchive.aspx"
    },
    {
      "source": "/api/beauty-official",
      "destination": "https://api.btstu.cn/sjbz/api.php"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
